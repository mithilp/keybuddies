rules_version = '2';

// There's no sign-in, so anyone with the app's config can read and write.
// These rules can't say who writes, only what: the paths the app uses and
// the shapes it writes to them. Everything else is turned down.
//
// Updates only check the fields they change, so studios, tracks and sounds
// from 2024 with fields the app doesn't write any more still take the app's
// normal updates.
service cloud.firestore {
  match /databases/{database}/documents {

    // studios and shared sounds both go by a 6 digit code
    function isCode(value) {
      return value is string && value.matches('^[0-9]{6}$');
    }

    function studioExists(code) {
      return isCode(code)
        && exists(/databases/$(database)/documents/studios/$(code));
    }

    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function listUpTo(value, max) {
      return value is list && value.size() <= max;
    }

    // the fields an update changes
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Caps. Rules can't look inside every item of a list, so lists only get
    // a length. Each is far past what anyone makes in the app.
    function bpm(value) {
      return value in ['80', '120', '160'];
    }

    function loopIds(value) {
      return listUpTo(value, 100);
    }

    // a track's cells, 8 beats each. 1000 is over 30 minutes at 160 BPM.
    function cells(value) {
      return listUpTo(value, 1000);
    }

    // a sound's notes, each { note, start, end }
    function notes(value) {
      return listUpTo(value, 5000);
    }

    // drum sounds can say how many steps their grid has
    function drumSteps(value) {
      return value in [16, 32];
    }

    match /studios/{code} {
      // Studios are only opened by their code. Nothing in the app lists
      // them, and a list would hand out every code.
      allow get: if isCode(code);

      // claimStudio in src/utils/codes.ts
      allow create: if isCode(code)
        && request.resource.data.keys().hasOnly(['createdAt', 'bpm'])
        && request.resource.data.keys().hasAll(['createdAt', 'bpm'])
        && request.resource.data.createdAt is timestamp
        && bpm(request.resource.data.bpm);

      // the tempo buttons, and the loop library in src/utils/library.ts
      allow update: if isCode(code) && studioChange(request.resource.data);

      // the app never deletes a studio

      function studioChange(data) {
        let keys = changed();
        return keys.hasOnly(['bpm', 'library', 'libraryRemoved'])
          && (!('bpm' in keys) || bpm(data.bpm))
          && (!('library' in keys) || loopIds(data.library))
          && (!('libraryRemoved' in keys) || loopIds(data.libraryRemoved));
      }

      match /tracks/{track} {
        // the studio page listens to all of them, cell edits read one
        allow read: if isCode(code);

        // new studios get four, and the New Track button adds one
        allow create: if studioExists(code)
          && request.resource.data.keys().hasOnly(['createdAt', 'name', 'order', 'notes'])
          && request.resource.data.keys().hasAll(['createdAt', 'name', 'order', 'notes'])
          && request.resource.data.createdAt is timestamp
          && text(request.resource.data.name, 1, 100)
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order <= 1000
          && cells(request.resource.data.notes);

        // only the cells change, see src/utils/cells.ts
        allow update: if isCode(code)
          && changed().hasOnly(['notes'])
          && cells(request.resource.data.notes);

        // the delete button on a track
        allow delete: if isCode(code);
      }
    }

    match /sounds/{sound} {
      // read by id when a song is put together, by share code, and by
      // which studios have them
      allow read: if true;

      // a recorded piano or drum sound, or a copy of one. It starts out in
      // the one studio it was made in.
      allow create: if newSound(request.resource.data);

      // edits to the notes, a new share code, and adding it to a studio or
      // taking it out
      allow update: if soundChange(request.resource.data);

      // the app takes a sound out of a studio with `in`, it never deletes one

      function newSound(data) {
        return data.keys().hasOnly(['name', 'type', 'sequence', 'in', 'code', 'steps'])
          && data.keys().hasAll(['name', 'type', 'sequence', 'in', 'code'])
          && text(data.name, 1, 200)
          && data.type in ['piano', 'drum']
          && notes(data.sequence)
          && data.in is list
          && data.in.size() == 1
          && studioExists(data.in[0])
          && isCode(data.code)
          && (!('steps' in data) || (data.type == 'drum' && drumSteps(data.steps)));
      }

      function soundChange(data) {
        let keys = changed();
        return keys.hasOnly(['sequence', 'code', 'in', 'steps'])
          && (!('sequence' in keys) || notes(data.sequence))
          && (!('code' in keys) || isCode(data.code))
          && (!('in' in keys) || studiosChange(data.in))
          && (!('steps' in keys) || drumSteps(data.steps));
      }

      // `in` is changed with arrayUnion and arrayRemove, one studio at a
      // time. A studio that's added has to be there.
      function studiosChange(studios) {
        let old = resource.data.get('in', []);
        let added = studios is list ? studios.removeAll(old is list ? old : []) : [];
        return listUpTo(studios, 1000)
          && (added.size() == 0
            || (added.size() == 1 && studioExists(added[0])));
      }
    }
  }
}
